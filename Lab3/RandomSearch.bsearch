<?xml version='1.0' encoding='utf-8'?>
<search>
  <bsearchVersionNumber>1.10</bsearchVersionNumber>
  <modelInfo>
    <modelFile>Urban-Suite-Pollution-Lab3.nlogo</modelFile>
    <modelSetupCommands>setup</modelSetupCommands>
    <modelStepCommands>search-step</modelStepCommands>
    <modelStopCondition />
    <modelStepLimit>100</modelStepLimit>
    <modelMetricReporter>policy-loss</modelMetricReporter>
    <modelMeasureIf>ticks &gt;= 51</modelMeasureIf>
  </modelInfo>
  <fitnessInfo>
    <fitnessMinimized>true</fitnessMinimized>
    <fitnessCollecting>MEAN_ACROSS_STEPS</fitnessCollecting>
    <fitnessSamplingReplications>5</fitnessSamplingReplications>
    <fitnessCombineReplications>MEAN</fitnessCombineReplications>
  </fitnessInfo>
  <searchSpace>
    <paramSpec>["initial-population" [30 10 100]]</paramSpec>
    <paramSpec>["birth-rate" [0.05 0.005 0.10]]</paramSpec>
    <paramSpec>["planting-rate" [0 0.005 0.10]]</paramSpec>
    <paramSpec>["power-plants" 10]</paramSpec>
    <paramSpec>["polluting-rate" 3]</paramSpec>
  </searchSpace>
  <searchMethod type="RandomSearch" />
  <chromosomeRepresentation type="GrayBinaryChromosome" />
  <caching>false</caching>
  <evaluationLimit>500</evaluationLimit>
  <bestCheckingNumReplications>0</bestCheckingNumReplications>
</search>